# ── Build artifacts ──
dist/
dist_bak/
build/
build_bak/
build_tools/
__pycache__/
*.pyc
*.pyo
*.spec

# ── Test / scratch ──
_tmpchk/
tmp/

# ── Binaries & large downloads (fetched at build time, GitHub has 100MB file limit) ──
ffmpeg-static/
ffmpeg-btbn.zip
ffmpeg-essentials.7z
ffmpeg-full.7z
installer_output/
*.exe
*.dll
*.7z
*.zip
nul

# ── Runtime user data (presets / tasks / settings live in %APPDATA%) ──
presets/

# ── OS / editor ──
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# ── Local scratch / debug (this workspace) ──
_installer_build.log
build_exe_v*.log
build_installer_v*.log
_extract.py
_test_*.py
.edge_tmp_profile/

# ── 发布脚本临时产物 ──
# rel_* 是 GitHub Release 上传脚本的中转文件（含 tag/正文/响应体），
# 每次发布会重新生成，属临时产物，不应进版本库。
rel_*.json

# ── 凭据：绝不入库 ──
# _cred_helper.sh 一度把 GitHub PAT 明文写在脚本里（发布时供 curl 读取）。
# 该文件已被删除，此处加规则双保险：即使日后重建，也不会被误提交。
_cred_helper.sh
*_cred*.sh
.env
.env.*
